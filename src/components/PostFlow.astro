---
import { getCollection } from "astro:content";

const { lang = "en" } = Astro.props;
const allPosts = await getCollection("post", ({ data }) => data.lang === lang && !data.draft);
const posts = allPosts.sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf());
const pinned = posts.filter((post) => post.data.pinned);
const topics = [...new Set(posts.flatMap((post) => post.data.tags))].sort((a, b) => a.localeCompare(b));

const copy = {
  en: {
    heading: "Latest research notes",
    subheading: "A continuous AI research stream, organized by topics and search.",
    search: "Search",
    searchPlaceholder: "Search papers, projects, concepts...",
    pinned: "Pinned",
    topics: "Auto Topics",
    pipeline: "Publishing Pipeline",
    pipelineItems: ["Draft inside paper/project repo", "Review facts against source material", "Promote MDX into blog repo"]
  },
  zh: {
    heading: "最新研究笔记",
    subheading: "以博客流为主体，用主题和搜索组织 AI 研究内容。",
    search: "搜索",
    searchPlaceholder: "搜索论文、项目、概念...",
    pinned: "置顶",
    topics: "自动主题",
    pipeline: "发布流程",
    pipelineItems: ["在论文/项目仓库中写初稿", "根据原始材料做事实核查", "导入博客仓库发布 MDX"]
  }
}[lang];
---

<main class="flow-layout">
  <section aria-labelledby="feed-title">
    <div class="feed-header">
      <div>
        <h1 id="feed-title">{copy.heading}</h1>
        <p>{copy.subheading}</p>
      </div>
    </div>

    <div class="post-list">
      {posts.map((post) => (
        <article class="post-card">
          <div class="meta">
            <span>{post.data.published.toLocaleDateString(lang === "zh" ? "zh-CN" : "en-US")}</span>
            {post.data.paper && <span>Paper</span>}
            {post.data.pinned && <span>{copy.pinned}</span>}
          </div>
          <h2>{post.data.title}</h2>
          <p>{post.data.description}</p>
          <div class="tag-row">
            {post.data.tags.map((tag) => <span class="tag">{tag}</span>)}
          </div>
        </article>
      ))}
    </div>
  </section>

  <aside class="rail" aria-label="Research index">
    <section class="rail-section">
      <h2>{copy.search}</h2>
      <input class="search-box" type="search" placeholder={copy.searchPlaceholder} />
    </section>

    <section class="rail-section">
      <h2>{copy.pinned}</h2>
      <ul class="rail-list">
        {pinned.map((post) => <li>{post.data.title}</li>)}
      </ul>
    </section>

    <section class="rail-section">
      <h2>{copy.topics}</h2>
      <div class="topic-cloud">
        {topics.map((topic) => <span class="tag">{topic}</span>)}
      </div>
    </section>

    <section class="rail-section">
      <h2>{copy.pipeline}</h2>
      <ul class="rail-list">
        {copy.pipelineItems.map((item) => <li>{item}</li>)}
      </ul>
    </section>
  </aside>
</main>

