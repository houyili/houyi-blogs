---
import { getCollection } from "astro:content";

type Lang = "en" | "zh";
type Flow = "all" | "papers" | "open-source" | "reading-notes";
type FlowCopy = {
  heading: string;
  subheading: string;
  search: string;
  pinned: string;
  topics: string;
  allResearch: string;
  endOfFlow: string;
  emptyTitle: string;
  emptyText: string;
  searchEmptyTitle: string;
  searchEmptyText: string;
  noPinned: string;
  noTopics: string;
};

const { lang = "en", flow = "all" } = Astro.props as { lang?: Lang; flow?: Flow };
const allPosts = await getCollection("post", ({ data }) => data.lang === lang && !data.draft);
const sortedPosts = allPosts.sort((a, b) => {
  if (a.data.pinned !== b.data.pinned) return a.data.pinned ? -1 : 1;
  const dateDiff = b.data.published.valueOf() - a.data.published.valueOf();
  if (dateDiff !== 0) return dateDiff;
  return a.data.post_slug.localeCompare(b.data.post_slug);
});
const posts = sortedPosts.filter((post) => {
  if (flow === "all") return true;
  if (flow === "papers") return post.data.paper;
  if (flow === "open-source") return !post.data.paper && Boolean(post.data.project);
  return !post.data.paper && !post.data.project;
});
const topicCounts = new Map<string, number>();
const topicOrder: string[] = [];
for (const post of posts) {
  for (const tag of post.data.tags) {
    if (!topicCounts.has(tag)) topicOrder.push(tag);
    topicCounts.set(tag, (topicCounts.get(tag) ?? 0) + 1);
  }
}
const topicEntries = topicOrder
  .map((topic) => [topic, topicCounts.get(topic) ?? 0] as const)
  .sort((a, b) => b[1] - a[1] || topicOrder.indexOf(a[0]) - topicOrder.indexOf(b[0]));
const topics = topicEntries.map(([topic]) => topic);
const visibleTopics = topics.slice(0, 5);
const collapsedTopics = topics.slice(5);
const moreTopicsLabel = lang === "en" ? "More" : "更多";
const topicEmptyTitle = lang === "en" ? "No posts for this topic." : "暂无该主题文章。";
const topicEmptyText = lang === "en"
  ? "Choose another topic or return to the full research flow."
  : "请选择其他主题，或返回完整研究流。";
const searchExamples = topics.slice(0, 2);
const searchPlaceholder = lang === "en"
  ? searchExamples.length > 0 ? `Search ${searchExamples.join(", ")}...` : "Search this flow..."
  : searchExamples.length > 0 ? `搜索 ${searchExamples.join("、")}...` : "搜索当前列表...";
const pinnedPosts = posts.filter((post) => post.data.pinned);
const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL.slice(0, -1)
  : import.meta.env.BASE_URL;

const allCopy = {
  en: {
    all: {
      heading: "AGI research learning notes and work explainers.",
      subheading: "Driven by AGI curiosity and mission: my papers, projects, and learning notes.",
      emptyTitle: "No research notes yet.",
      emptyText: "New AGI notes will appear here once published.",
      allResearch: "All Research",
    },
    papers: {
      heading: "My papers.",
      subheading: "Paper explainers and research notes for my own work.",
      emptyTitle: "No paper explainers yet.",
      emptyText: "Paper explainers will appear here once published.",
      allResearch: "All Papers",
    },
    "open-source": {
      heading: "Open-source launches.",
      subheading: "Release notes and technical writeups for my open-source AGI projects.",
      emptyTitle: "No open-source launches yet.",
      emptyText: "Open-source project posts will appear here once published.",
      allResearch: "All Projects",
    },
    "reading-notes": {
      heading: "Reading notes.",
      subheading: "Technical readings from papers, systems, and ideas that sharpen my AGI path.",
      emptyTitle: "No reading notes yet.",
      emptyText: "Reading notes will appear here once published.",
      allResearch: "All Notes",
    },
    search: "Search",
    pinned: "Pinned",
    topics: "Topics",
    endOfFlow: "You're all caught up. More research to come.",
    searchEmptyTitle: "No posts match this search.",
    searchEmptyText: "Try another query or clear the search box to return to the full flow.",
    noPinned: "No pinned posts in this flow.",
    noTopics: "No topics yet.",
  },
  zh: {
    all: {
      heading: "AGI 研究学习笔记与工作解读",
      subheading: "由对 AGI 的好奇心和使命感驱动：解读自己的论文和项目，也记录自己对 AGI 的学习过程。",
      emptyTitle: "暂无研究笔记。",
      emptyText: "新的 AGI 笔记发布后会出现在这里。",
      allResearch: "全部研究",
    },
    papers: {
      heading: "我的论文",
      subheading: "对自己论文和研究工作的解释、复盘与延展。",
      emptyTitle: "暂无论文解读。",
      emptyText: "新的论文解读发布后会出现在这里。",
      allResearch: "全部论文",
    },
    "open-source": {
      heading: "开源项目",
      subheading: "围绕自己开源 AGI 项目的发布、设计和技术说明。",
      emptyTitle: "暂无开源项目发布。",
      emptyText: "新的开源项目文章发布后会出现在这里。",
      allResearch: "全部项目",
    },
    "reading-notes": {
      heading: "阅读笔记",
      subheading: "记录对 AGI 相关论文、系统和技术路径的学习过程。",
      emptyTitle: "暂无阅读笔记。",
      emptyText: "新的阅读笔记发布后会出现在这里。",
      allResearch: "全部笔记",
    },
    search: "搜索",
    pinned: "置顶",
    topics: "主题索引",
    endOfFlow: "已浏览全部文章，新的研究还在继续。",
    searchEmptyTitle: "没有匹配的文章。",
    searchEmptyText: "可以换一个关键词，或清空搜索框返回完整列表。",
    noPinned: "当前列表暂无置顶文章。",
    noTopics: "暂无主题。",
  }
} satisfies Record<Lang, Record<Flow, Pick<FlowCopy, "heading" | "subheading" | "emptyTitle" | "emptyText" | "allResearch">> & Omit<FlowCopy, "heading" | "subheading" | "emptyTitle" | "emptyText" | "allResearch">>;

const copy = { ...allCopy[lang], ...allCopy[lang][flow] };
---

<section class="hero" aria-labelledby="site-title">
  <div class="hero-copy">
    <div class="eyebrow"><span class="status-dot" aria-hidden="true"></span>{lang === "zh" ? "保持好奇，持续探索" : "Stay curious. Keep exploring."}</div>
    <h1 id="site-title">{lang === "zh" && flow === "all" ? <><span>AGI 研究学习笔记</span><span>与工作解读</span></> : copy.heading}</h1>
    <p>{copy.subheading}</p>
  </div>
</section>

<main class="flow-layout">
  <section class="post-stream anchor-target" aria-label={lang === "zh" ? "研究文章" : "Research flow"}>
    <div class="stream-heading">
      <h2>{copy.allResearch}</h2>
      <span data-result-count data-count-template={lang === "zh" ? "{count} 篇文章" : "{count} entries"} data-count-single={lang === "zh" ? "1 篇文章" : "1 entry"} aria-live="polite" aria-atomic="true">{lang === "zh" ? `${posts.length} 篇文章` : `${posts.length} ${posts.length === 1 ? "entry" : "entries"}`}</span>
    </div>
    <div class="post-list" data-post-list>
      {posts.length > 0 ? (
        <>
          {posts.map((post, index) => (
            <a
              class:list={["post-card-link", { "is-pinned": post.data.pinned }]}
              href={`${base}/${lang}/${post.data.post_slug}/`}
              data-post-card
              data-tags={post.data.tags.map((tag) => encodeURIComponent(tag)).join(" ")}
              data-published={post.data.published.valueOf()}
              data-post-slug={post.data.post_slug}
              data-post-href={`${base}/${lang}/${post.data.post_slug}/`}
              data-original-index={index}
            >
              <article class="post-card">
                <div class="post-copy">
                  <div class="meta">
                    {post.data.pinned && <span class="pill primary"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m16 3 5 5-4 2-3 5-2-2-5 5-1-1 5-5-2-2 5-3z" /></svg>{copy.pinned}</span>}
                    {post.data.category && <span class="pill">{post.data.category}</span>}
                  </div>
                  <h2>{post.data.title}</h2>
                  <p>{post.data.description}</p>
                  <div class="tag-row">
                    {post.data.tags.map((tag) => <span class="tag">{tag}</span>)}
                  </div>
                  <div class="post-card-footer">
                    <span class="post-date"><time datetime={post.data.published.toISOString().slice(0, 10)}>{post.data.published.toLocaleDateString(lang === "zh" ? "zh-CN" : "en-US", { year: "numeric", month: "short", day: "numeric", timeZone: "UTC" })}</time>{post.data.read_time && <><span aria-hidden="true"> · </span>{post.data.read_time}</>}</span>
                    <span class="read-note">{lang === "zh" ? "阅读全文" : "Read note"}<span aria-hidden="true">→</span></span>
                  </div>
                </div>
                {post.data.image && (
                  <figure class="post-figure">
                    <img src={`${base}${post.data.image}`} alt={`${post.data.title} figure`} loading={index === 0 ? "eager" : "lazy"} decoding="async" />
                  </figure>
                )}
              </article>
            </a>
          ))}
          <div
            class="empty-flow topic-empty is-hidden"
            data-topic-empty
            data-topic-empty-title={topicEmptyTitle}
            data-topic-empty-text={topicEmptyText}
            data-search-empty-title={copy.searchEmptyTitle}
            data-search-empty-text={copy.searchEmptyText}
          >
            <h2 data-empty-title>{topicEmptyTitle}</h2>
            <p data-empty-text>{topicEmptyText}</p>
          </div>
          <div class="flow-end" data-flow-end><span aria-hidden="true">✳</span>{copy.endOfFlow}</div>
        </>
      ) : (
        <div class="empty-flow">
          <h2>{copy.emptyTitle}</h2>
          <p>{copy.emptyText}</p>
        </div>
      )}
    </div>
  </section>

  <aside class="rail" aria-label={lang === "zh" ? "研究索引" : "Research index"}>
    <section class="rail-section">
      <h2><label for="flow-search">{copy.search}</label></h2>
      <div class="search-field">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" /><path d="m16 16 4.5 4.5" /></svg>
        <input id="flow-search" class="search-box" type="search" placeholder={searchPlaceholder} data-search-box />
      </div>
    </section>

    <details class="rail-index" open data-rail-index>
      <summary class="rail-index-toggle">
        <span>{lang === "zh" ? "浏览主题与置顶" : "Browse topics & pinned"}</span>
        <span class="rail-index-icon" aria-hidden="true">+</span>
      </summary>
      <div class="rail-index-content">
        <section class="rail-section" data-pinned-section>
          <h2>{copy.pinned}</h2>
          <ul class="pinned-list">
            {pinnedPosts.length > 0 ? (
              pinnedPosts.map((post) => (
                <li>
                  <a href={`${base}/${lang}/${post.data.post_slug}/`}>
                    <strong>{post.data.title}</strong>
                    <span>{[post.data.category, post.data.venue].filter(Boolean).join(" · ")}</span>
                  </a>
                </li>
              ))
            ) : (
              <li><span>{copy.noPinned}</span></li>
            )}
          </ul>
        </section>

        <section class="rail-section">
          <h2>{copy.topics}</h2>
          <ul class="topic-list">
            <li>
              <button class="topic-filter is-active" type="button" data-topic-filter="" data-topic-key="" aria-pressed="true">
                <strong>{copy.allResearch}</strong>
                <span>{posts.length}</span>
              </button>
            </li>
            {topics.length > 0 ? (
              <>
                {visibleTopics.map((topic) => (
                  <li>
                    <button
                      class="topic-filter"
                      type="button"
                      data-topic-filter={topic}
                      data-topic-key={encodeURIComponent(topic)}
                      aria-pressed="false"
                    >
                      <span>{topic}</span>
                      <span>{topicCounts.get(topic)}</span>
                    </button>
                  </li>
                ))}
                {collapsedTopics.length > 0 && (
                  <li class="topic-more">
                    <details>
                      <summary>
                        <span>{moreTopicsLabel}</span>
                        <span>{collapsedTopics.length}</span>
                      </summary>
                      <ul class="topic-list topic-list-collapsed">
                        {collapsedTopics.map((topic) => (
                          <li>
                            <button
                              class="topic-filter"
                              type="button"
                              data-topic-filter={topic}
                              data-topic-key={encodeURIComponent(topic)}
                              aria-pressed="false"
                            >
                              <span>{topic}</span>
                              <span>{topicCounts.get(topic)}</span>
                            </button>
                          </li>
                        ))}
                      </ul>
                    </details>
                  </li>
                )}
              </>
            ) : (
              <li><span>{copy.noTopics}</span><span>0</span></li>
            )}
          </ul>
        </section>
      </div>
    </details>
  </aside>
</main>

<style>
  :global(.flow-layout.is-topic-filtered .pill.primary),
  :global(.flow-layout.is-search-filtered .pill.primary) {
    display: none;
  }

  .is-hidden {
    display: none !important;
  }

  .topic-filter {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    width: 100%;
    border: 0;
    min-height: 44px;
    align-items: center;
    padding: 8px 10px;
    border-radius: 8px;
    background: transparent;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
  }

  .topic-filter:hover span:first-child,
  .topic-filter:focus-visible span:first-child {
    color: var(--accent-strong);
  }

  .topic-filter:focus-visible {
    border-radius: 6px;
    outline: 2px solid rgba(47, 127, 120, 0.28);
    outline-offset: 4px;
  }

  .topic-filter.is-active span:first-child,
  .topic-filter.is-active strong {
    color: var(--accent-strong);
    font-weight: 760;
  }

  .topic-filter.is-active {
    background: var(--accent-soft);
  }

  .topic-filter:hover {
    background: var(--bg);
  }

  .topic-more {
    display: block;
    padding: 0;
  }

  .topic-more details {
    display: grid;
  }

  .topic-more summary {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    align-items: center;
    min-height: 44px;
    padding: 9px 10px;
    color: var(--muted);
    cursor: pointer;
    list-style: none;
  }

  .topic-more summary::-webkit-details-marker {
    display: none;
  }

  .topic-more summary span:first-child::after {
    content: " +";
    color: var(--accent-strong);
  }

  .topic-more details[open] summary span:first-child::after {
    content: " -";
  }

  .topic-list-collapsed {
    border-top: 1px solid var(--line);
  }

  .topic-list-collapsed li {
    padding-left: 10px;
  }
</style>

<script>
  const topicButtons = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-topic-filter]"));
  const postCards = Array.from(document.querySelectorAll<HTMLElement>("[data-post-card]"));
  const postList = document.querySelector<HTMLElement>("[data-post-list]");
  const topicEmpty = document.querySelector<HTMLElement>("[data-topic-empty]");
  const emptyTitle = topicEmpty?.querySelector<HTMLElement>("[data-empty-title]");
  const emptyText = topicEmpty?.querySelector<HTMLElement>("[data-empty-text]");
  const flowEnd = document.querySelector<HTMLElement>("[data-flow-end]");
  const pinnedSection = document.querySelector<HTMLElement>("[data-pinned-section]");
  const flowLayout = document.querySelector<HTMLElement>(".flow-layout");
  const searchBox = document.querySelector<HTMLInputElement>("[data-search-box]");
  const resultCount = document.querySelector<HTMLElement>("[data-result-count]");
  const railIndex = document.querySelector<HTMLDetailsElement>("[data-rail-index]");
  const compactLayout = window.matchMedia("(max-width: 900px)");
  const syncRailIndex = () => {
    if (railIndex) railIndex.open = !compactLayout.matches || new URLSearchParams(window.location.search).has("tag");
  };
  syncRailIndex();
  compactLayout.addEventListener("change", syncRailIndex);
  let activeTopic = "";
  let activeSearchQuery = "";
  let activeSearchPaths: string[] | null = null;
  let searchRun = 0;
  let searchTimer: number | undefined;
  let pagefindPromise: Promise<any> | null = null;

  const normalizePath = (path: string) => {
    const pathname = new URL(path, window.location.origin).pathname;
    return pathname.endsWith("/") ? pathname : `${pathname}/`;
  };

  const getPagefind = () => {
    const loadPagefind = new Function("path", "return import(path)") as (path: string) => Promise<any>;
    pagefindPromise ??= loadPagefind("/pagefind/pagefind.js").catch(() => null);
    return pagefindPromise;
  };

  const fallbackSearchPaths = (query: string) => {
    const needle = query.toLowerCase();
    return postCards
      .filter((card) => (card.textContent ?? "").toLowerCase().includes(needle))
      .map((card) => normalizePath(card.dataset.postHref ?? card.getAttribute("href") ?? ""));
  };

  const runSearch = async (query: string) => {
    const run = ++searchRun;
    activeSearchQuery = query.trim();

    if (!activeSearchQuery) {
      activeSearchPaths = null;
      applyFilters();
      return;
    }

    const pagefind = await getPagefind();
    if (run !== searchRun) return;

    try {
      const response = pagefind ? await pagefind.search(activeSearchQuery) : null;
      if (run !== searchRun) return;

      if (response?.results) {
        const resultData = await Promise.all(response.results.map((result: any) => result.data()));
        if (run !== searchRun) return;
        activeSearchPaths = resultData.map((result: any) => normalizePath(result.url));
      } else {
        activeSearchPaths = fallbackSearchPaths(activeSearchQuery);
      }
    } catch {
      if (run !== searchRun) return;
      activeSearchPaths = fallbackSearchPaths(activeSearchQuery);
    }

    applyFilters();
  };

  const applyFilters = (updateUrl = true) => {
    const topic = activeTopic;
    const selectedButton = topicButtons.find((button) => button.dataset.topicFilter === topic) ?? topicButtons[0];
    const selectedKey = selectedButton?.dataset.topicKey ?? "";
    const isTopicFiltered = selectedKey !== "";
    const isSearchFiltered = activeSearchQuery !== "";
    const searchOrder = new Map((activeSearchPaths ?? []).map((path, index) => [path, index]));
    let visibleCount = 0;
    const sortedCards = [...postCards].sort((a, b) => {
      if (isSearchFiltered) {
        const aPath = normalizePath(a.dataset.postHref ?? a.getAttribute("href") ?? "");
        const bPath = normalizePath(b.dataset.postHref ?? b.getAttribute("href") ?? "");
        const searchDiff = (searchOrder.get(aPath) ?? Number.MAX_SAFE_INTEGER) - (searchOrder.get(bPath) ?? Number.MAX_SAFE_INTEGER);
        if (searchDiff !== 0) return searchDiff;
      }

      if (isTopicFiltered || isSearchFiltered) {
        const dateDiff = Number(b.dataset.published ?? 0) - Number(a.dataset.published ?? 0);
        if (dateDiff !== 0) return dateDiff;
        return (a.dataset.postSlug ?? "").localeCompare(b.dataset.postSlug ?? "");
      }
      return Number(a.dataset.originalIndex ?? 0) - Number(b.dataset.originalIndex ?? 0);
    });

    topicButtons.forEach((button) => {
      const isActive = button === selectedButton;
      button.classList.toggle("is-active", isActive);
      button.setAttribute("aria-pressed", String(isActive));
    });

    const selectedDetails = selectedButton?.closest("details");
    if (selectedDetails) selectedDetails.open = true;

    sortedCards.forEach((card) => {
      postList?.insertBefore(card, topicEmpty ?? flowEnd ?? null);
      const tags = (card.dataset.tags ?? "").split(" ").filter(Boolean);
      const cardPath = normalizePath(card.dataset.postHref ?? card.getAttribute("href") ?? "");
      const matchesTopic = selectedKey === "" || tags.includes(selectedKey);
      const matchesSearch = !isSearchFiltered || searchOrder.has(cardPath);
      const isVisible = matchesTopic && matchesSearch;
      card.classList.toggle("is-hidden", !isVisible);
      if (isVisible) visibleCount += 1;
    });

    if (resultCount) {
      resultCount.textContent = visibleCount === 1
        ? resultCount.dataset.countSingle ?? ""
        : (resultCount.dataset.countTemplate ?? "").replace("{count}", String(visibleCount));
    }

    if (emptyTitle && emptyText && topicEmpty) {
      emptyTitle.textContent = isSearchFiltered
        ? topicEmpty.dataset.searchEmptyTitle ?? ""
        : topicEmpty.dataset.topicEmptyTitle ?? "";
      emptyText.textContent = isSearchFiltered
        ? topicEmpty.dataset.searchEmptyText ?? ""
        : topicEmpty.dataset.topicEmptyText ?? "";
    }

    topicEmpty?.classList.toggle("is-hidden", visibleCount > 0);
    flowEnd?.classList.toggle("is-hidden", visibleCount === 0 || isTopicFiltered || isSearchFiltered);
    pinnedSection?.classList.toggle("is-hidden", isTopicFiltered || isSearchFiltered);
    flowLayout?.classList.toggle("is-topic-filtered", isTopicFiltered);
    flowLayout?.classList.toggle("is-search-filtered", isSearchFiltered);

    if (updateUrl) {
      const url = new URL(window.location.href);
      if (topic) {
        url.searchParams.set("tag", topic);
      } else {
        url.searchParams.delete("tag");
      }
      if (activeSearchQuery) {
        url.searchParams.set("q", activeSearchQuery);
      } else {
        url.searchParams.delete("q");
      }
      window.history.replaceState({}, "", url);
    }
  };

  const setTopicFilter = (topic: string, updateUrl = true) => {
    activeTopic = topic;
    applyFilters(updateUrl);
  };

  topicButtons.forEach((button) => {
    button.addEventListener("click", () => {
      setTopicFilter(button.dataset.topicFilter ?? "");
    });
  });

  searchBox?.addEventListener("input", () => {
    window.clearTimeout(searchTimer);
    searchTimer = window.setTimeout(() => {
      runSearch(searchBox.value);
    }, 180);
  });

  const initialParams = new URLSearchParams(window.location.search);
  const initialTag = initialParams.get("tag") ?? "";
  const initialQuery = initialParams.get("q") ?? "";
  if (initialTag) setTopicFilter(initialTag, false);
  if (initialQuery && searchBox) {
    searchBox.value = initialQuery;
    runSearch(initialQuery);
  }
</script>
