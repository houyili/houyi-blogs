---
import { getCollection } from "astro:content";

type Lang = "en" | "zh";
type FlowCopy = {
  heading: string;
  subheading: string;
  search: string;
  pinned: string;
  topics: string;
  allResearch: string;
  loadMore: string;
  openSource: string;
  readingNotes: string;
  noOpenSource: string;
  noReadingNotes: string;
};

const { lang = "en" } = Astro.props as { lang?: Lang };
const allPosts = await getCollection("post", ({ data }) => data.lang === lang && !data.draft);
const posts = allPosts.sort((a, b) => {
  if (a.data.pinned !== b.data.pinned) return a.data.pinned ? -1 : 1;
  const dateDiff = b.data.published.valueOf() - a.data.published.valueOf();
  if (dateDiff !== 0) return dateDiff;
  return a.data.post_slug.localeCompare(b.data.post_slug);
});
const topicCounts = new Map<string, number>();
const topicOrder: string[] = [];
for (const post of posts) {
  for (const tag of post.data.tags) {
    if (!topicCounts.has(tag)) topicOrder.push(tag);
    topicCounts.set(tag, (topicCounts.get(tag) ?? 0) + 1);
  }
}
const topicEntries = topicOrder
  .map((topic) => [topic, topicCounts.get(topic) ?? 0] as const)
  .sort((a, b) => b[1] - a[1] || topicOrder.indexOf(a[0]) - topicOrder.indexOf(b[0]));
const topics = topicEntries.map(([topic]) => topic);
const searchExamples = topics.slice(0, 4);
const searchPlaceholder = lang === "en"
  ? `Search ${searchExamples.join(", ")}...`
  : `搜索 ${searchExamples.join("、")}...`;
const pinnedPosts = posts.filter((post) => post.data.pinned);
const openSourcePosts = posts.filter((post) => !post.data.paper && Boolean(post.data.project));
const readingNotePosts = posts.filter((post) => !post.data.paper && !post.data.project);
const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL.slice(0, -1)
  : import.meta.env.BASE_URL;

const allCopy = {
  en: {
    heading: "AGI research learning notes and work explainers.",
    subheading: "Driven by AGI curiosity and mission: my papers, projects, and learning notes.",
    search: "Search",
    pinned: "Pinned",
    topics: "Topics",
    allResearch: "All Research",
    loadMore: "Load more research notes",
    openSource: "Open Source",
    readingNotes: "Reading Notes",
    noOpenSource: "No open-source launches yet.",
    noReadingNotes: "No reading notes yet.",
  },
  zh: {
    heading: "AGI 研究学习笔记与工作解读",
    subheading: "由对 AGI 的好奇心和使命感驱动：解读自己的论文和项目，也记录自己对 AGI 的学习过程。",
    search: "搜索",
    pinned: "置顶",
    topics: "主题索引",
    allResearch: "全部研究",
    loadMore: "加载更多研究笔记",
    openSource: "开源项目",
    readingNotes: "阅读笔记",
    noOpenSource: "暂无开源项目发布。",
    noReadingNotes: "暂无阅读笔记。",
  }
} satisfies Record<Lang, FlowCopy>;

const copy = allCopy[lang];
---

<section class="hero" aria-labelledby="site-title">
  <div>
    <h1 id="site-title">{copy.heading}</h1>
    <p>{copy.subheading}</p>
  </div>
</section>

<main class="flow-layout">
  <section id="papers" class="post-stream anchor-target" aria-label="Research flow">
    <div class="post-list">
      {posts.map((post) => (
        <a class="post-card-link" href={`${base}/${lang}/${post.data.post_slug}/`}>
          <article class="post-card">
            <div class="post-copy">
              <div class="meta">
                {post.data.pinned && <span class="pill primary">{copy.pinned}</span>}
                {post.data.category && <span class="pill">{post.data.category}</span>}
                {post.data.read_time && <span class="pill">{post.data.read_time}</span>}
              </div>
              <h2>{post.data.title}</h2>
              <p>{post.data.description}</p>
              <div class="tag-row">
                {post.data.tags.map((tag) => <span class="tag">{tag}</span>)}
              </div>
            </div>
            {post.data.image && (
              <figure class="post-figure">
                <img src={`${base}${post.data.image}`} alt={`${post.data.title} figure`} loading="lazy" />
              </figure>
            )}
          </article>
        </a>
      ))}
      <div class="load">{copy.loadMore}</div>
    </div>
  </section>

  <aside class="rail" aria-label="Research index">
    <section class="rail-section">
      <h2>{copy.search}</h2>
      <input class="search-box" type="search" placeholder={searchPlaceholder} />
    </section>

    <section class="rail-section">
      <h2>{copy.pinned}</h2>
      <ul class="pinned-list">
        {pinnedPosts.map((post) => (
          <li>
            <a href={`${base}/${lang}/${post.data.post_slug}/`}>
              <strong>{post.data.title}</strong>
              <span>{[post.data.category, post.data.venue].filter(Boolean).join(" · ")}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section class="rail-section">
      <h2>{copy.topics}</h2>
      <ul class="topic-list">
        <li><strong>{copy.allResearch}</strong><span>{posts.length}</span></li>
        {topics.map((topic) => <li><span>{topic}</span><span>{topicCounts.get(topic)}</span></li>)}
      </ul>
    </section>
  </aside>
</main>

<section class="collection-sections" aria-label="Secondary collections">
  <section id="open-source" class="collection-section anchor-target">
    <h2>{copy.openSource}</h2>
    {openSourcePosts.length > 0 ? (
      <ul>
        {openSourcePosts.map((post) => (
          <li><a href={`${base}/${lang}/${post.data.post_slug}/`}>{post.data.title}</a></li>
        ))}
      </ul>
    ) : (
      <p>{copy.noOpenSource}</p>
    )}
  </section>

  <section id="reading-notes" class="collection-section anchor-target">
    <h2>{copy.readingNotes}</h2>
    {readingNotePosts.length > 0 ? (
      <ul>
        {readingNotePosts.map((post) => (
          <li><a href={`${base}/${lang}/${post.data.post_slug}/`}>{post.data.title}</a></li>
        ))}
      </ul>
    ) : (
      <p>{copy.noReadingNotes}</p>
    )}
  </section>
</section>
