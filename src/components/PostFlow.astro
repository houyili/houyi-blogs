---
import { getCollection } from "astro:content";

const { lang = "en" } = Astro.props;
const allPosts = await getCollection("post", ({ data }) => data.lang === lang && !data.draft);
const posts = allPosts.sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf());
const topics = [...new Set(posts.flatMap((post) => post.data.tags))].sort((a, b) => a.localeCompare(b));
const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL.slice(0, -1)
  : import.meta.env.BASE_URL;

const copy = {
  en: {
    heading: "AGI research notes, paper explainers, and open-source launches.",
    subheading: "A mission-driven research flow for understanding AGI: my papers, my projects, and technical readings that sharpen the path.",
    search: "Search",
    searchPlaceholder: "Search MoE, Step Law, 20%, data reuse...",
    pinned: "Pinned",
    topics: "Auto Topics",
    pipeline: "Publishing Pipeline",
    allResearch: "All Research",
    loadMore: "Load more research notes",
    pipelineItems: ["project/blog.md", "-> reviewed MDX", "-> en/zh routes", "-> X + Reddit cards"],
    pinnedItems: [
      ["MoE vs Dense under equal resources", "Paper explainer · ICLR 2026"],
      ["Step3 is large yet affordable", "Model-system co-design"],
      ["Predictable Scale reading map", "Scaling laws · Farseer"]
    ]
  },
  zh: {
    heading: "AGI 研究笔记、论文解读与开源项目发布。",
    subheading: "由对 AGI 的好奇心和使命感驱动：解释自己的论文与项目，也拆解值得认真理解的外部论文和技术。",
    search: "搜索",
    searchPlaceholder: "搜索 MoE、Step Law、20%、数据复用...",
    pinned: "置顶",
    topics: "自动主题",
    pipeline: "发布流程",
    allResearch: "全部研究",
    loadMore: "加载更多研究笔记",
    pipelineItems: ["project/blog.md", "-> reviewed MDX", "-> en/zh routes", "-> X + Reddit cards"],
    pinnedItems: [
      ["等资源下的 MoE vs Dense", "论文解读 · ICLR 2026"],
      ["Step3 很大，但并不昂贵", "模型与系统协同设计"],
      ["Predictable Scale 阅读地图", "Scaling laws · Farseer"]
    ]
  }
}[lang];
---

<section class="hero" aria-labelledby="site-title">
  <div>
    <h1 id="site-title">{copy.heading}</h1>
    <p>{copy.subheading}</p>
  </div>
</section>

<main class="flow-layout">
  <section class="post-stream" aria-label="Research flow">
    <div class="post-list">
      {posts.map((post) => (
        <article class="post-card">
          <div class="post-copy">
            <div class="meta">
              {post.data.pinned && <span class="pill primary">{copy.pinned}</span>}
              {post.data.category && <span class="pill">{post.data.category}</span>}
              {post.data.read_time && <span class="pill">{post.data.read_time}</span>}
            </div>
            <h2>{post.data.title}</h2>
            <p>{post.data.description}</p>
            <div class="tag-row">
              {post.data.tags.map((tag) => <span class="tag">{tag}</span>)}
            </div>
          </div>
          {post.data.image && (
            <figure class="post-figure">
              <img src={`${base}${post.data.image}`} alt={`${post.data.title} figure`} loading="lazy" />
            </figure>
          )}
        </article>
      ))}
      <div class="load">{copy.loadMore}</div>
    </div>
  </section>

  <aside class="rail" aria-label="Research index">
    <section class="rail-section">
      <h2>{copy.search}</h2>
      <input class="search-box" type="search" placeholder={copy.searchPlaceholder} />
    </section>

    <section class="rail-section">
      <h2>{copy.pinned}</h2>
      <ul class="pinned-list">
        {copy.pinnedItems.map(([title, meta]) => (
          <li>
            <strong>{title}</strong>
            <span>{meta}</span>
          </li>
        ))}
      </ul>
    </section>

    <section class="rail-section">
      <h2>{copy.topics}</h2>
      <ul class="topic-list">
        <li><strong>{copy.allResearch}</strong><span>42</span></li>
        {topics.map((topic, index) => <li><span>{topic}</span><span>{index + 7}</span></li>)}
      </ul>
    </section>

    <section class="rail-section">
      <h2>{copy.pipeline}</h2>
      <div class="workflow">
        {copy.pipelineItems.map((item) => <span>{item}</span>)}
      </div>
    </section>
  </aside>
</main>
