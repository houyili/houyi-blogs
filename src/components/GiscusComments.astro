---
type Lang = "en" | "zh";

const { lang = "en" } = Astro.props as { lang?: Lang };

const repo = import.meta.env.PUBLIC_GISCUS_REPO ?? "houyili/houyi-blogs";
const repoId = import.meta.env.PUBLIC_GISCUS_REPO_ID ?? "R_kgDOSSJGDA";
const category = import.meta.env.PUBLIC_GISCUS_CATEGORY ?? "General";
const categoryId = import.meta.env.PUBLIC_GISCUS_CATEGORY_ID ?? "DIC_kwDOSSJGDM4C8KTm";
const giscusLang = lang === "zh" ? "zh-CN" : "en";
const title = lang === "zh" ? "评论" : "Comments";
const note =
  lang === "zh"
    ? "评论由 GitHub Discussions 托管。登录 GitHub 后即可参与讨论。"
    : "Comments are powered by GitHub Discussions. Sign in with GitHub to join the thread.";
---

<section class="comments-section" aria-labelledby="comments-title">
  <div class="comments-heading">
    <h2 id="comments-title">{title}</h2>
    <p>{note}</p>
  </div>
  <div class="giscus-frame">
    <script
      is:inline
      src="https://giscus.app/client.js"
      data-repo={repo}
      data-repo-id={repoId}
      data-category={category}
      data-category-id={categoryId}
      data-mapping="pathname"
      data-strict="1"
      data-reactions-enabled="1"
      data-emit-metadata="0"
      data-input-position="bottom"
      data-theme="light"
      data-lang={giscusLang}
      crossorigin="anonymous"
      async
    ></script>
  </div>
  <noscript>{note}</noscript>
</section>
