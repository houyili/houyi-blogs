---
type Lang = "en" | "zh";
const { lang = "en" } = Astro.props as { lang?: Lang };

const allCopy = {
  en: {
    title: "About Houyi Li",
    lead: "I am Houyi Li. This blog is driven by my curiosity and sense of mission around AGI. Here I explain my papers, record my learning notes on AGI, and publish my open-source projects.",
    body: "I hope to use this blog to record the growth and deepening of my understanding of AGI, and to discuss and exchange ideas with more AGI researchers here.",
    homepage: "Personal homepage",
    back: "Back to AGI Flow"
  },
  zh: {
    title: "关于 Houyi Li",
    lead: "我是 Houyi Li，这个博客由我对 AGI 的好奇心和使命感驱动。我会在这里解释自己的论文，会记录我对AGI的学习笔记，也会发布自己的开源项目。",
    body: "希望利用这个博客记录我对AGI认知成长和深化的过程，也希望能和更多的AGI研究员在此讨论和交流。",
    homepage: "个人主页",
    back: "返回 AGI Flow"
  }
} satisfies Record<Lang, {
  title: string;
  lead: string;
  body: string;
  homepage: string;
  back: string;
}>;

const copy = allCopy[lang];

const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<main class="about-page" aria-labelledby="about-title">
  <h1 id="about-title">{copy.title}</h1>
  <div class="about-copy">
    <p>{copy.lead}</p>
    <p>{copy.body}</p>
  </div>
  <div class="about-actions">
    <a class="about-link" href="https://houyili.github.io/">{copy.homepage}</a>
    <a class="about-link secondary" href={`${base}${lang}/`}>{copy.back}</a>
  </div>
</main>
