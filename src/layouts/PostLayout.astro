---
import BaseLayout from "./BaseLayout.astro";
import GiscusComments from "../components/GiscusComments.astro";

type Heading = {
  depth: number;
  slug: string;
  text: string;
};

const { post, headings = [] } = Astro.props as { post: any; headings?: Heading[] };
const lang = post.data.lang;
const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const translationHref = post.data.translation
  ? `${base}${post.data.translation}/`
  : lang === "en"
    ? `${base}zh/`
    : `${base}en/`;
const homeHref = `${base}${lang}/`;
const published = new Intl.DateTimeFormat(lang === "zh" ? "zh-CN" : "en", {
  year: "numeric",
  month: "short",
  day: "numeric"
}).format(post.data.published);
const switchLabel = lang === "en" ? "中文" : "EN";
const current = post.data.paper ? "papers" : post.data.project ? "open-source" : "reading-notes";
const showHeaderDescription = !post.data.hide_description_in_header;
const backLabel = lang === "en" ? "Back to AGI Flow" : "返回 AGI Flow";
const metaParts = [
  post.data.venue_type && post.data.venue ? `${post.data.venue} ${post.data.venue_type}` : post.data.venue,
  post.data.category,
  post.data.read_time,
  published
].filter(Boolean);
const tocLabel = lang === "en" ? "On this page" : "本文目录";
const tocHeadings = headings
  .filter((heading) => heading.depth === 2 || heading.depth === 3)
  .map((heading) => ({
    ...heading,
    text: heading.text.replace(/[#*_`]/g, "").trim()
  }));
---

<BaseLayout
  title={`${post.data.title} | Houyi AI Research Flow`}
  description={post.data.description}
  lang={lang}
  current={current}
  switchHref={translationHref}
>
  <div class="post-shell">
    <article class="post-page">
      <header class="post-header">
        <div class="post-kicker">
          {metaParts.map((part) => <span>{part}</span>)}
        </div>
        <h1>{post.data.title}</h1>
        {showHeaderDescription && <p>{post.data.description}</p>}
        <div class="post-actions">
          <a class="about-link" href={translationHref}>{switchLabel}</a>
          <a class="about-link secondary" href={homeHref}>{backLabel}</a>
        </div>
      </header>

      <div class="post-content" data-pagefind-body>
        <slot />
      </div>

      <GiscusComments lang={lang} />
    </article>

    {tocHeadings.length > 0 && (
      <aside class="post-toc" aria-label={tocLabel}>
        <div class="post-toc-card">
          <h2>{tocLabel}</h2>
          <nav>
            {tocHeadings.map((heading) => (
              <a class:list={[`depth-${heading.depth}`]} href={`#${heading.slug}`} data-toc-link>{heading.text}</a>
            ))}
          </nav>
        </div>
      </aside>
    )}
  </div>
</BaseLayout>

<script>
  const tocLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('.post-toc-card a[data-toc-link]'));
  const tocHeadings = tocLinks
    .map((link) => {
      const hash = link.getAttribute('href')?.slice(1);
      return hash ? document.getElementById(decodeURIComponent(hash)) : null;
    })
    .filter((heading): heading is HTMLElement => heading instanceof HTMLElement);

  let ticking = false;

  function setActiveTocLink() {
    ticking = false;
    if (!tocHeadings.length) return;

    const offset = Math.min(320, window.innerHeight * 0.35);
    let activeId = tocHeadings[0].id;

    for (const heading of tocHeadings) {
      if (heading.getBoundingClientRect().top <= offset) {
        activeId = heading.id;
      } else {
        break;
      }
    }

    for (const link of tocLinks) {
      const linkId = decodeURIComponent(link.getAttribute('href')?.slice(1) ?? '');
      const isActive = linkId === activeId;
      link.classList.toggle('is-active', isActive);
      if (isActive) {
        link.setAttribute('aria-current', 'true');
      } else {
        link.removeAttribute('aria-current');
      }
    }
  }

  function requestTocUpdate() {
    if (ticking) return;
    ticking = true;
    window.requestAnimationFrame(setActiveTocLink);
  }

  setActiveTocLink();
  window.addEventListener('scroll', requestTocUpdate, { passive: true });
  window.addEventListener('resize', requestTocUpdate);
  window.addEventListener('hashchange', requestTocUpdate);
</script>
