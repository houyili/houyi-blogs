---
import "../styles/global.css";
import "katex/dist/katex.min.css";

type Lang = "en" | "zh";
type Current = "flow" | "papers" | "open-source" | "reading-notes" | "about";
type JsonLd = Record<string, unknown> | Record<string, unknown>[];
const {
  title = "Houyi AI Research Flow",
  description = "Mission-driven AGI research notes, paper explainers, and open-source project launches.",
  lang = "en",
  current = "flow",
  switchHref,
  image,
  type = "website",
  publishedTime,
  modifiedTime,
  structuredData,
  noindex = false,
  canonicalHref
} = Astro.props as {
  title?: string;
  description?: string;
  lang?: Lang;
  current?: Current;
  switchHref?: string;
  image?: string;
  type?: "website" | "article";
  publishedTime?: string;
  modifiedTime?: string;
  structuredData?: JsonLd;
  noindex?: boolean;
  canonicalHref?: string;
};

const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const site = Astro.site?.toString() ?? "https://houyi.blog/";
const canonicalUrl = canonicalHref
  ? new URL(canonicalHref, site).toString()
  : new URL(Astro.url.pathname, site).toString();

const allNav = {
  en: {
    flow: "AGI Flow",
    papers: "My Papers",
    openSource: "Open Source",
    readingNotes: "Reading Notes",
    about: "About",
    switchLabel: "中文",
  },
  zh: {
    flow: "AGI Flow",
    papers: "我的论文",
    openSource: "开源项目",
    readingNotes: "阅读笔记",
    about: "关于",
    switchLabel: "EN",
  }
} satisfies Record<Lang, {
  flow: string;
  papers: string;
  openSource: string;
  readingNotes: string;
  about: string;
  switchLabel: string;
}>;

const nav = allNav[lang];
const currentBase = `${base}${lang}/`;
const otherLang = lang === "en" ? "zh" : "en";
const currentPath = {
  flow: "",
  papers: "papers/",
  "open-source": "open-source/",
  "reading-notes": "reading-notes/",
  about: "about/"
}[current];
const resolvedSwitchHref = switchHref ?? `${base}${otherLang}/${currentPath}`;
const switchUrl = new URL(resolvedSwitchHref, site).toString();
const enAlternateUrl = lang === "en" ? canonicalUrl : switchUrl;
const zhAlternateUrl = lang === "zh" ? canonicalUrl : switchUrl;
const xDefaultUrl = enAlternateUrl;
const imageUrl = image ? new URL(image, site).toString() : undefined;
const rssUrl = new URL("rss.xml", site).toString();
const locale = lang === "zh" ? "zh_CN" : "en_US";
const alternateLocale = lang === "zh" ? "en_US" : "zh_CN";
const personId = new URL("#houyi-li", site).toString();
const websiteId = new URL("#website", site).toString();
const webpageId = `${canonicalUrl}#webpage`;
const personSchema = {
  "@type": "Person",
  "@id": personId,
  name: "Houyi Li",
  url: "https://houyi.blog/en/about/",
  sameAs: [
    "https://houyili.github.io/",
    "https://scholar.google.com/citations?user=LkqxJqoAAAAJ&hl=zh-CN",
    "https://x.com/JackLee1551695"
  ]
};
const websiteSchema = {
  "@type": "WebSite",
  "@id": websiteId,
  name: "Houyi AI Research Flow",
  url: new URL(base, site).toString(),
  description,
  inLanguage: lang,
  author: { "@id": personId },
  publisher: { "@id": personId }
};
const webpageSchema = {
  "@type": "WebPage",
  "@id": webpageId,
  url: canonicalUrl,
  name: title,
  description,
  inLanguage: lang,
  isPartOf: { "@id": websiteId },
  author: { "@id": personId },
  ...(imageUrl ? { primaryImageOfPage: imageUrl } : {})
};
const defaultStructuredData = {
  "@context": "https://schema.org",
  "@graph": [personSchema, websiteSchema, webpageSchema]
};
const jsonLd = structuredData ?? defaultStructuredData;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content="Houyi Li" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="en" href={enAlternateUrl} />
    <link rel="alternate" hreflang="zh" href={zhAlternateUrl} />
    <link rel="alternate" hreflang="x-default" href={xDefaultUrl} />
    <link rel="alternate" type="application/rss+xml" title="Houyi AI Research Flow RSS" href={rssUrl} />
    <meta property="og:site_name" content="Houyi AI Research Flow" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={locale} />
    <meta property="og:locale:alternate" content={alternateLocale} />
    {imageUrl && <meta property="og:image" content={imageUrl} />}
    <meta name="twitter:card" content={imageUrl ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {imageUrl && <meta name="twitter:image" content={imageUrl} />}
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
    <title>{title}</title>
  </head>
  <body>
    <div class="site-shell">
      <header class="topbar">
        <a class="brand" href={base}>
          <span class="brand-mark" aria-hidden="true">HL</span>
          <strong>Houyi Li</strong>
        </a>
        <nav class="nav" aria-label="Primary navigation">
          <a href={currentBase} aria-current={current === "flow" ? "page" : undefined}>{nav.flow}</a>
          <a href={resolvedSwitchHref}>{nav.switchLabel}</a>
          <a href={`${currentBase}about/`} aria-current={current === "about" ? "page" : undefined}>{nav.about}</a>
          <a href={`${currentBase}papers/`} aria-current={current === "papers" ? "page" : undefined}>{nav.papers}</a>
          <a href={`${currentBase}open-source/`} aria-current={current === "open-source" ? "page" : undefined}>{nav.openSource}</a>
          <a href={`${currentBase}reading-notes/`} aria-current={current === "reading-notes" ? "page" : undefined}>{nav.readingNotes}</a>
        </nav>
      </header>
      <slot />
    </div>
  </body>
</html>
