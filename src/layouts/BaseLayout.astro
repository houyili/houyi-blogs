---
import "../styles/global.css";

const {
  title = "Houyi AI Research Flow",
  description = "AI/AGI research notes, paper explainers, and open-source project logs."
} = Astro.props;

const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <div class="site-shell">
      <header class="topbar">
        <a class="brand" href={base}>
          <span class="brand-mark" aria-hidden="true">HL</span>
          <strong>Houyi Li</strong>
        </a>
        <nav class="nav" aria-label="Primary navigation">
          <a href={`${base}en/`} aria-current="page">Research Flow</a>
          <a href={`${base}en/`}>Papers</a>
          <a href={`${base}en/`}>Projects</a>
          <a href={`${base}en/`}>Talks</a>
          <a href={`${base}en/`}>About</a>
          <a href={`${base}zh/`}>EN / 中文</a>
        </nav>
      </header>
      <slot />
    </div>
  </body>
</html>
