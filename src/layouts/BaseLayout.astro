---
import "../styles/global.css";

const {
  title = "Houyi AI Research Flow",
  description = "AI/AGI research notes, paper explainers, and open-source project logs."
} = Astro.props;

const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <div class="site-shell">
      <header class="topbar">
        <a class="brand" href={base}>
          <strong>Houyi AI Research Flow</strong>
          <span>AI/AGI papers, projects, and technical notes</span>
        </a>
        <nav class="nav" aria-label="Primary navigation">
          <a href={`${base}en/`}>English</a>
          <a href={`${base}zh/`}>中文</a>
          <a href="https://github.com/houyili">GitHub</a>
        </nav>
      </header>
      <slot />
    </div>
  </body>
</html>
