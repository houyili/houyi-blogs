---
import "../styles/global.css";

const {
  title = "Houyi AI Research Flow",
  description = "Mission-driven AGI research notes, paper explainers, and open-source project launches.",
  lang = "en"
} = Astro.props;

const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const nav = {
  en: {
    flow: "AGI Flow",
    papers: "My Papers",
    projects: "Open Source",
    notes: "Reading Notes",
    about: "About",
    switchLabel: "中文",
    switchHref: `${base}zh/`
  },
  zh: {
    flow: "AGI Flow",
    papers: "我的论文",
    projects: "开源项目",
    notes: "阅读笔记",
    about: "关于",
    switchLabel: "EN",
    switchHref: `${base}en/`
  }
}[lang];

const currentBase = `${base}${lang}/`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <div class="site-shell">
      <header class="topbar">
        <a class="brand" href={base}>
          <span class="brand-mark" aria-hidden="true">HL</span>
          <strong>Houyi Li</strong>
        </a>
        <nav class="nav" aria-label="Primary navigation">
          <a href={currentBase} aria-current="page">{nav.flow}</a>
          <a href={`${currentBase}#papers`}>{nav.papers}</a>
          <a href={`${currentBase}#open-source`}>{nav.projects}</a>
          <a href={`${currentBase}#reading-notes`}>{nav.notes}</a>
          <a href={`${currentBase}#about`}>{nav.about}</a>
          <a href={nav.switchHref}>{nav.switchLabel}</a>
        </nav>
      </header>
      <slot />
    </div>
  </body>
</html>
