---
import "../styles/global.css";
import "katex/dist/katex.min.css";

type Lang = "en" | "zh";
type Current = "flow" | "papers" | "open-source" | "reading-notes" | "about";
const {
  title = "Houyi AI Research Flow",
  description = "Mission-driven AGI research notes, paper explainers, and open-source project launches.",
  lang = "en",
  current = "flow",
  switchHref
} = Astro.props as {
  title?: string;
  description?: string;
  lang?: Lang;
  current?: Current;
  switchHref?: string;
};

const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const allNav = {
  en: {
    flow: "AGI Flow",
    papers: "My Papers",
    openSource: "Open Source",
    readingNotes: "Reading Notes",
    about: "About",
    switchLabel: "中文",
  },
  zh: {
    flow: "AGI Flow",
    papers: "我的论文",
    openSource: "开源项目",
    readingNotes: "阅读笔记",
    about: "关于",
    switchLabel: "EN",
  }
} satisfies Record<Lang, {
  flow: string;
  papers: string;
  openSource: string;
  readingNotes: string;
  about: string;
  switchLabel: string;
}>;

const nav = allNav[lang];
const currentBase = `${base}${lang}/`;
const otherLang = lang === "en" ? "zh" : "en";
const currentPath = {
  flow: "",
  papers: "papers/",
  "open-source": "open-source/",
  "reading-notes": "reading-notes/",
  about: "about/"
}[current];
const resolvedSwitchHref = switchHref ?? `${base}${otherLang}/${currentPath}`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <div class="site-shell">
      <header class="topbar">
        <a class="brand" href={base}>
          <span class="brand-mark" aria-hidden="true">HL</span>
          <strong>Houyi Li</strong>
        </a>
        <nav class="nav" aria-label="Primary navigation">
          <a href={currentBase} aria-current={current === "flow" ? "page" : undefined}>{nav.flow}</a>
          <a href={resolvedSwitchHref}>{nav.switchLabel}</a>
          <a href={`${currentBase}about/`} aria-current={current === "about" ? "page" : undefined}>{nav.about}</a>
          <a href={`${currentBase}papers/`} aria-current={current === "papers" ? "page" : undefined}>{nav.papers}</a>
          <a href={`${currentBase}open-source/`} aria-current={current === "open-source" ? "page" : undefined}>{nav.openSource}</a>
          <a href={`${currentBase}reading-notes/`} aria-current={current === "reading-notes" ? "page" : undefined}>{nav.readingNotes}</a>
        </nav>
      </header>
      <slot />
    </div>
  </body>
</html>
